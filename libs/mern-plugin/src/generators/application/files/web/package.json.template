{
  "name": "<%= projectName %>",
  "private": true,
  "dependencies": {
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "nx": {
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
